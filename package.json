{
  "name": "motion-studio",
  "version": "0.2.0",
  "description": "Lightweight prompt-to-motion-graphics CLI engine powered by Google Antigravity CLI (agy) and Remotion",
  "main": "dist/cli.js",
  "bin": {
    "motion": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "motion": "node dist/cli.js",
    "studio": "node dist/cli.js studio --open",
    "render": "node dist/cli.js render",
    "typecheck": "tsc --noEmit",
    "workspace:init": "node scripts/init-workspace.js"
  },
  "keywords": [
    "motion-graphics",
    "remotion",
    "threejs",
    "antigravity",
    "ai",
    "cli",
    "video-generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
